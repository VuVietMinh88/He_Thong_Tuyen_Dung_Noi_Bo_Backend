# Copy to .env if absent and fill private values. Do not surround values with quotes.
# Team development database: PostgreSQL 16, database/user recruitment, port 5432.
DB_URL=jdbc:postgresql://localhost:5432/recruitment
DB_USERNAME=recruitment
# Use the password supplied with your team's local container; never commit the real .env.
DB_PASSWORD=

# Choose s5 for a new DB/S5 history; feedback for its existing V26/V27 history. Never switch after V26.
# See docs/database/migration-lineages.md. This setting selects migrations, not application features.
APP_MIGRATION_LINEAGE=s5

# Base64 encoding of at least 32 random bytes.
AUTH_JWT_SECRET=

# Frontend URLs separated by commas. Bearer tokens are sent in headers, not cookies.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable only for first startup with an empty database.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Local mail catcher (no real mailbox required). For real SMTP configure host/auth/STARTTLS privately.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
MAIL_FROM=support@internal-hire.com
RESET_PASSWORD_PAGE_URL=http://localhost:5173/reset-password
ACCOUNT_ACTIVATION_PAGE_URL=http://localhost:5173/activate-account
ACCOUNT_ACTIVATION_TTL=24h

# Footer of account emails; keep it equal to VITE_COMPANY_NAME and VITE_SUPPORT_* of the frontend. This file is read
# as ISO-8859-1, so write Vietnamese letters as Unicode escapes, as in the default values below. Keep the name lines
# commented unless you change them: an empty name stops the startup.
# MAIL_COMPANY_NAME=H\u1ec7 th\u1ed1ng tuy\u1ec3n d\u1ee5ng n\u1ed9i b\u1ed9
# MAIL_SUPPORT_TEAM=B\u1ed9 ph\u1eadn Nh\u00e2n s\u1ef1
MAIL_SUPPORT_EMAIL=support@internal-hire.com
# Optional hotline (digits, spaces, + ( ) . -); empty leaves it out of the email.
MAIL_SUPPORT_PHONE=
# Optional PNG or JPEG logo of at most 200 KB, e.g. classpath:mail/logo.png or file:/opt/ttcs/mail-logo.png;
# empty shows the company name as text.
MAIL_LOGO=

SERVER_PORT=8080

# Keep false until real IP quota and transactional receipt/outbox adapters are installed.
APPLICATION_INTAKE_ENABLED=false
APPLICATION_INTAKE_MAX_CONCURRENT=2
# Empty for direct access. Comma-separated exact IPs/CIDRs of controlled proxies, never all clients/private networks.
APPLICATION_INTAKE_TRUSTED_PROXIES=
# Public application lookup: attempts per IPv4 address or IPv6 /64 per sliding hour (1..1000) and concurrent lookups
# per backend process (1..16). The client address uses APPLICATION_INTAKE_TRUSTED_PROXIES above.
APPLICATION_TRACKING_MAX_ATTEMPTS=30
APPLICATION_TRACKING_MAX_CONCURRENT=4
# Same MAIL_* transport/from as activation and password reset; do not duplicate SMTP settings.
APPLICATION_TRACKING_PAGE_URL=http://localhost:5173/tra-cuu
# Base64 of 32 random bytes, persisted privately across restarts. Keep blank until configured; never commit a key.
APPLICATION_CONFIRMATION_ENCRYPTION_KEY=
APPLICATION_CONFIRMATION_KEY_ID=v1
# Daily job posting expiry (task 356): Spring 6-field cron (second minute hour day month weekday) in
# app.business-zone (Asia/Ho_Chi_Minh); "-" turns it off. Unset means 00:05 every day. Leave the line commented
# unless you change it: an empty value stops the startup.
# JOB_POSTING_EXPIRY_CRON=0 5 0 * * *
# Emails after a candidate withdraws: worker poll interval, how long a recruiter notice waits to group the withdrawals
# of one requisition into one mail (0..3600 seconds), and the staff candidate profile page the recruiter mail links to.
APPLICATION_NOTICE_POLL_DELAY_MS=10000
APPLICATION_NOTICE_RECRUITER_DELAY_SECONDS=900
CANDIDATE_PROFILE_PAGE_URL=http://localhost:5173/candidates
# Staff referrals: referral forms read at once per backend process (1..8), and referral attempts per referrer in 24
# hours (1..100; a 404 or 409 counts too). Referrals need APPLICATION_CONFIRMATION_ENCRYPTION_KEY, not the intake flag.
REFERRAL_MAX_CONCURRENT=2
REFERRAL_MAX_PER_DAY=20
# Daily job posting expiry (task 356): Spring 6-field cron (second minute hour day month weekday) in
# app.business-zone (Asia/Ho_Chi_Minh); "-" turns it off. Unset means 00:05 every day. Leave the line commented
# unless you change it: an empty value stops the startup.
# JOB_POSTING_EXPIRY_CRON=0 5 0 * * *

# --- Production on internal-hire.com (uncomment in the server's private .env; never commit real values) ---
# Frontend https://internal-hire.com, API https://api.internal-hire.com. See docs/deployment/domain-and-mail.md.
# CORS_ALLOWED_ORIGINS=https://internal-hire.com,https://www.internal-hire.com
# RESET_PASSWORD_PAGE_URL=https://internal-hire.com/reset-password
# ACCOUNT_ACTIVATION_PAGE_URL=https://internal-hire.com/activate-account
# CANDIDATE_PROFILE_PAGE_URL=https://internal-hire.com/candidates
# Mailbox support@internal-hire.com hosted at ServerPoint. Use the ServerPoint server name: its TLS certificate is
# *.serverpoint.com, so mail.internal-hire.com fails hostname verification. Ports 587 and 465 both checked 2026-10-08.
# MAIL_HOST=emailserver4-186.serverpoint.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_SSL=false
# For port 465 instead: MAIL_PORT=465, MAIL_SMTP_STARTTLS=false, MAIL_SMTP_SSL=true
# MAIL_USERNAME=support@internal-hire.com
# MAIL_PASSWORD=
# MAIL_FROM=support@internal-hire.com

# Existing develop databases use feedback; candidate/S5 databases use s5. Never change an applied history.
APP_MIGRATION_LINEAGE=s5
# Email footer: the support mailbox is also the Reply-To of account emails. Add the hotline once it is official and
# the logo (file:/path of a PNG or JPEG on the server, at most 200 KB) once the official file exists. Set the legal
# company name and the support team once they are final, Vietnamese letters as Unicode escapes as in these defaults.
# MAIL_COMPANY_NAME=H\u1ec7 th\u1ed1ng tuy\u1ec3n d\u1ee5ng n\u1ed9i b\u1ed9
# MAIL_SUPPORT_TEAM=B\u1ed9 ph\u1eadn Nh\u00e2n s\u1ef1
# MAIL_SUPPORT_EMAIL=support@internal-hire.com
# MAIL_SUPPORT_PHONE=
# MAIL_LOGO=
