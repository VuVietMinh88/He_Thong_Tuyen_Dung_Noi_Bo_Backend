# Copy to .env if absent and fill private values. Do not surround values with quotes.
# Team development database: PostgreSQL 16, database/user recruitment, port 5432.
DB_URL=jdbc:postgresql://localhost:5432/recruitment
DB_USERNAME=recruitment
# Use the password supplied with your team's local container; never commit the real .env.
DB_PASSWORD=

# Base64 encoding of at least 32 random bytes.
AUTH_JWT_SECRET=

# Frontend URLs separated by commas. Bearer tokens are sent in headers, not cookies.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable only for first startup with an empty database.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Local mail catcher (no real mailbox required). For real SMTP configure host/auth/STARTTLS privately.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_SSL=false
MAIL_FROM=support@internal-hire.com
RESET_PASSWORD_PAGE_URL=http://localhost:5173/reset-password
ACCOUNT_ACTIVATION_PAGE_URL=http://localhost:5173/activate-account
ACCOUNT_ACTIVATION_TTL=24h

SERVER_PORT=8080

# Keep false until real IP quota and transactional receipt/outbox adapters are installed.
APPLICATION_INTAKE_ENABLED=false
APPLICATION_INTAKE_MAX_CONCURRENT=2
# Empty for direct access. Comma-separated exact IPs/CIDRs of controlled proxies, never all clients/private networks.
APPLICATION_INTAKE_TRUSTED_PROXIES=
# Same MAIL_* transport/from as activation and password reset; do not duplicate SMTP settings.
APPLICATION_TRACKING_PAGE_URL=http://localhost:5173/tra-cuu
# Base64 of 32 random bytes, persisted privately across restarts. Keep blank until configured; never commit a key.
APPLICATION_CONFIRMATION_ENCRYPTION_KEY=
APPLICATION_CONFIRMATION_KEY_ID=v1

# --- Production on internal-hire.com (uncomment in the server's private .env; never commit real values) ---
# Frontend https://internal-hire.com, API https://api.internal-hire.com. See docs/deployment/domain-and-mail.md.
# CORS_ALLOWED_ORIGINS=https://internal-hire.com,https://www.internal-hire.com
# RESET_PASSWORD_PAGE_URL=https://internal-hire.com/reset-password
# ACCOUNT_ACTIVATION_PAGE_URL=https://internal-hire.com/activate-account
# Mailbox support@internal-hire.com hosted at ServerPoint. Use the ServerPoint server name: its TLS certificate is
# *.serverpoint.com, so mail.internal-hire.com fails hostname verification. Ports 587 and 465 both checked 2026-10-08.
# MAIL_HOST=emailserver4-186.serverpoint.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_SSL=false
# For port 465 instead: MAIL_PORT=465, MAIL_SMTP_STARTTLS=false, MAIL_SMTP_SSL=true
# MAIL_USERNAME=support@internal-hire.com
# MAIL_PASSWORD=
# MAIL_FROM=support@internal-hire.com
